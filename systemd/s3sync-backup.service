[Unit]
Description=S3 bucket backup (s3sync)
Documentation=file:/opt/s3sync/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
# Credentials stay out of the unit: s3sync reads them from the config / env_file.
Environment=S3SYNC_CONFIG=/etc/s3sync/s3sync.yml
ExecStart=/opt/s3sync/s3sync.sh backup all --yes --quiet
# 3 = finished with warnings (skipped objects, an object changed mid-run): still a success
SuccessExitStatus=3
TimeoutStartSec=12h
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# Must match defaults.backup_dir (and metrics.textfile_dir if set).
ReadWritePaths=/backup/s3 /var/log

[Install]
WantedBy=multi-user.target
