[Unit]
Description=Weekly full verification and restore drill (bucketool)
Documentation=file:/opt/bucketool/SOP.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=BUCKETOOL_CONFIG=/etc/bucketool/bucketool.yml
# Re-hash every object of every newest backup, then restore into the scratch target.
ExecStart=/opt/bucketool/bucketool.sh verify --latest all --full --yes --quiet
ExecStart=/opt/bucketool/bucketool.sh drill --yes --quiet
TimeoutStartSec=12h
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/backup/s3 /var/log

[Install]
WantedBy=multi-user.target
