[Unit]
Description=Weekly full verification and restore drill (s3sync)
Documentation=file:/opt/s3sync/SOP.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=S3SYNC_CONFIG=/etc/s3sync/s3sync.yml
# Re-hash every object of every newest backup, then restore into the scratch target.
ExecStart=/opt/s3sync/s3sync.sh verify --latest all --full --yes --quiet
ExecStart=/opt/s3sync/s3sync.sh drill --yes --quiet
TimeoutStartSec=12h
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/backup/s3 /var/log

[Install]
WantedBy=multi-user.target
