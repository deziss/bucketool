s3sync.yaml
s3sync.json
s3sync.*.yml
s3sync.*.yaml
s3sync.*.json
!s3sync.example.yml
!s3sync.example.json
.env
.env.*
*.env
!*.env.example
*.key
*.pem
*.pass
*secrets*

